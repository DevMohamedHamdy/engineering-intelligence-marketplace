{
  "description": "EI hooks: hold project edits until a Feature/Fix task's recorded checkpoint passes; after each edit, flag existing symbols missing from the consumer analysis and remind Claude to draw the edit into the LIVE diagram; before `git push`, check the pushed code was reviewed locally (CodeRabbit --deep --fresh), follows the project's conventions, and applies a newly honored availability flag on every path",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_guard.py\" pre",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/push_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/live_reminder.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_guard.py\" post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
